# Copy to /etc/default/cowrie-log-sync and fill in your own values.
# Keep the real file out of the repository: it names a private host.

SENSOR_HOST=100.x.y.z
SENSOR_USER=david
SENSOR_PORT=61000
SENSOR_LOG_DIR=/srv/cowrie/log/
DEST_DIR=/srv/honeypot/raw
SSH_KEY=/home/david/.ssh/id_ed25519

# How long rotated logs are kept on this machine before being pruned.
RAW_RETENTION_DAYS=90
