# Resolves country and network for addresses seen by the honeypot.
# Triggered by cowrie-enrich.timer.

[Unit]
Description=Enrich honeypot source addresses
Documentation=https://github.com/DDMalo/IA-Honeypot
After=docker.service cowrie-ingest.service
Wants=docker.service

[Service]
Type=oneshot
User=david
WorkingDirectory=/home/david/IA-Honeypot
EnvironmentFile=/home/david/IA-Honeypot/.env
Environment=GEOIP_DIR=/srv/honeypot/geoip
ExecStart=/home/david/IA-Honeypot/.venv/bin/python -m honeypot_ai.enrich
TimeoutStartSec=900
