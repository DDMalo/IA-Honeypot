# MaxMind publishes GeoLite2 updates twice a week, so checking twice a week is
# enough. Address blocks are reassigned slowly; a database a few days old is
# fine, one a year old is not.
#
# This homelab is a laptop that is switched on to work on the project and off
# again, not a server. Persistent=true is what makes that work: a run missed
# while the machine was off happens at the next boot instead of being skipped
# until the following week.
#
# RandomizedDelaySec is kept short for the same reason. An hour of jitter is
# polite on a machine that is always up, and on one that is up for two hours it
# is a coin toss over whether the job runs before the lid closes. Ten minutes
# still avoids every GeoLite2 user hitting MaxMind on the same second.

[Unit]
Description=Update the GeoLite2 databases twice a week

[Timer]
OnCalendar=Tue,Fri 04:17
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
