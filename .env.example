# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

GEMINI_API_KEY=
ABUSEIPDB_API_KEY=
MAXMIND_LICENSE_KEY=
VIRUSTOTAL_API_KEY=

POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=honeypot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Overrides the four variables above when set. Handy for pointing tests or a
# one-off script at another database.
# DATABASE_URL=postgresql+psycopg://honeypot:change-me@localhost:5432/honeypot

# Grafana. The dashboard shows attacker IP addresses, so it has a real password
# and is bound to loopback only.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# Freshness alerts (python -m honeypot_ai.health --notify). The topic is the
# only secret: anyone who knows it can read the alerts, so make it long and
# random, for example the output of `openssl rand -hex 16`, and subscribe to it
# in the ntfy app. NTFY_SERVER only needs setting for a self-hosted server.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Local model, for the comparison against the hosted one. Only needed when
# running Ollama; the provider falls back to these values.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
