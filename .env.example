# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

GEMINI_API_KEY=
ABUSEIPDB_API_KEY=
MAXMIND_LICENSE_KEY=
VIRUSTOTAL_API_KEY=

POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=honeypot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Overrides the four variables above when set. Handy for pointing tests or a
# one-off script at another database.
# DATABASE_URL=postgresql+psycopg://honeypot:change-me@localhost:5432/honeypot

# Grafana. The dashboard shows attacker IP addresses, so it has a real password
# and is bound to loopback only.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
